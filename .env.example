# .env のサンプル
# 使い方:
#   1. このファイルを .env にコピー
#        cp .env.example .env
#   2. INTERIOR_AGENT_PATH を自分の環境に合わせて設定
#
# .env は .gitignore に登録されているので、各自のローカル設定として保管される。

# InteriorAgent のシーンを保存するホスト側のディレクトリ
# このパスが docker-compose.dev.yml で /data/InteriorAgent にマウントされる
INTERIOR_AGENT_PATH=/home/USERNAME/datasets/InteriorAgent
